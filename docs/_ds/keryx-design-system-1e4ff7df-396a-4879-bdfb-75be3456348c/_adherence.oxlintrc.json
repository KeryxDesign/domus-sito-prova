      "--gold": "other",
      "--gold-dark": "other",
      "--gold-bg": "color",
      "--gold-ink": "other",
      "--primary": "color",
      "--primary-foreground": "other",
      "--shadow-elegant": "shadow",
      "--shadow-card": "shadow",
      "--gradient-testimonials": "color",
      "--font-sans": "font",
