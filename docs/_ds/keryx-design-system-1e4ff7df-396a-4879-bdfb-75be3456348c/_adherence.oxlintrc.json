{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--background",
      "--border",
      "--card",
      "--coral",
      "--coral-hover",
      "--cream",
      "--cream-dark",
      "--font-display",
      "--font-mono",
      "--font-sans",
      "--font-serif",
      "--foreground",
      "--fs-body",
      "--fs-body-l",
      "--fs-h1",
      "--fs-h1-lg",
      "--fs-h2",
      "--fs-h2-lg",
      "--fs-h3",
      "--fs-kicker",
      "--fs-kicker-s",
      "--fs-lead",
      "--fs-stat",
      "--gold",
      "--gold-bg",
      "--gold-dark",
      "--gold-ink",
      "--gradient-testimonials",
      "--h-header",
      "--kx-delay",
      "--lh-body",
      "--lh-stat",
      "--lh-tight",
      "--lh-title",
      "--muted",
      "--muted-foreground",
      "--navy",
      "--navy-dark",
      "--primary",
      "--primary-foreground",
      "--radius",
      "--radius-2xl",
      "--radius-xl",
      "--ring",
      "--shadow-card",
      "--shadow-elegant",
      "--sky-blue",
      "--sp-page-x",
      "--sp-section-y",
      "--sp-section-y-lg",
      "--tracking-kicker",
      "--w-page",
      "--w-read",
      "--w-wide"
    ],
    "tokenKinds": {
      "--background": "other",
      "--foreground": "other",
      "--card": "other",
      "--muted": "other",
      "--muted-foreground": "other",
      "--border": "other",
